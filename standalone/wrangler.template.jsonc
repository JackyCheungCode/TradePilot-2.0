{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "replace-with-your-worker-name",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "r2_buckets": [
    {
      "binding": "SKILL_ARTIFACTS",
      "bucket_name": "replace-with-your-own-r2-bucket"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
    "SUPABASE_ANON_KEY": "YOUR_PROJECT_PUBLISHABLE_OR_ANON_KEY"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "workflows": [
    {
      "name": "replace-with-your-agent-orchestration-workflow",
      "binding": "AGENT_ORCHESTRATION_WORKFLOW",
      "class_name": "AgentOrchestrationWorkflow"
    },
    {
      "name": "replace-with-your-contact-enrichment-workflow",
      "binding": "CONTACT_ENRICHMENT_WORKFLOW",
      "class_name": "ContactEnrichmentWorkflow"
    },
    {
      "name": "replace-with-your-facebook-discovery-workflow",
      "binding": "FACEBOOK_DISCOVERY_WORKFLOW",
      "class_name": "FacebookDiscoveryWorkflow"
    },
    {
      "name": "replace-with-your-instagram-discovery-workflow",
      "binding": "INSTAGRAM_DISCOVERY_WORKFLOW",
      "class_name": "InstagramDiscoveryWorkflow"
    },
    {
      "name": "replace-with-your-lead-discovery-workflow",
      "binding": "LEAD_DISCOVERY_WORKFLOW",
      "class_name": "LeadDiscoveryWorkflow"
    }
  ]
}
