# Frontend public Supabase configuration (publishable/anon key only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Standalone Cloudflare build configuration. These values must belong to your account/project.
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Never place Supabase service-role keys or private API credentials in VITE_ variables.
